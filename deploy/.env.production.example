# Production env for EC2 — copy to repo root as .env:
#   cp deploy/.env.production.example .env

# Must match the URL users open in the browser (no trailing slash)
FRONTEND_URL=http://sendingmail.chetanchauhan.fun

# Docker frontend port on the host.
# Use 8080 if Ubuntu nginx already uses port 80 (see deploy/nginx-host.conf).
APP_PORT=8080

# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Seeded administrator login
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# SendGrid API key (server only — never commit real keys)
SENDGRID_API_KEY=

# SendGrid throughput (optional). emails/sec ≈ BATCH_SIZE × MAX_RPS
# SENDGRID_BATCH_SIZE=200
# SENDGRID_WORKER_CONCURRENCY=4
# SENDGRID_MAX_RPS=8

