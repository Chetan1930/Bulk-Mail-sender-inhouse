# Copy to .env before running docker compose release:
#   cp .env.example .env

# URL you open in the browser (CORS). For local release:
FRONTEND_URL=http://localhost:8080

# Host port for the all-in-one app (nginx inside container)
APP_PORT=8080

# Optional — only needed if you turn OPEN_ACCESS=false later
JWT_SECRET=change-me-to-a-long-random-secret

# Open app with no login (default). Set to false only if you want JWT login again.
OPEN_ACCESS=true

# Optional extra admin account (not required for open access)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
