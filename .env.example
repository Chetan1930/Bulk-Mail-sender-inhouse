# Copy to .env and update before deploying:
#   cp .env.example .env
#
# Backend-only on EC2 (no frontend container):
#   docker compose -f docker-compose.backend.yml up -d --build
#   See docs/DEPLOY_BACKEND_DOCKER.md

# CORS origin — must match the URL you open in the browser (no trailing slash)
# All-in-one release (docker-compose.release.yml): http://YOUR_EC2_IP:8080
# Local release test: http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Host port published by the all-in-one app container (maps to nginx :80 inside)
APP_PORT=8080

# Set a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Login-only: keep false in production (you provision users via SEED_ADMIN_*)
ALLOW_PUBLIC_SIGNUP=false

# Seed admin user on start — set SEED_ADMIN_* in .env only (not in this file)
SEED_ON_START=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Optional email provider defaults
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
