# Copy to .env and update before deploying:
#   cp .env.example .env
#
# Backend-only on EC2 (no frontend container):
#   docker compose -f docker-compose.backend.yml up -d --build
#   See docs/DEPLOY_BACKEND_DOCKER.md

# CORS origin — browser frontend URL (no trailing slash)
# Postman-only testing: http://localhost is fine
# Later (Cloudflare Pages): https://your-app.pages.dev
FRONTEND_URL=http://localhost

# Only used by full-stack docker-compose.yml (frontend container). Ignore for backend-only.
APP_PORT=80

# Set a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Login-only: keep false in production (you provision users via SEED_ADMIN_*)
ALLOW_PUBLIC_SIGNUP=false

# Seed admin user on start — set SEED_ADMIN_* in .env only (not in this file)
SEED_ON_START=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Optional email provider defaults
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
