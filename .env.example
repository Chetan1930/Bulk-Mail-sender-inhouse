# Copy to .env before running docker compose release:
#   cp .env.example .env

# URL you open in the browser (CORS). For local release:
FRONTEND_URL=http://localhost:8080

# Host port for the all-in-one app (nginx inside container)
APP_PORT=8080

# Used to sign administrator sessions.
JWT_SECRET=change-me-to-a-long-random-secret

# Required administrator account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# SendGrid API key (server only — never put this in the browser)
SENDGRID_API_KEY=

# SendGrid throughput (optional). emails/sec ≈ BATCH_SIZE × MAX_RPS
# SENDGRID_BATCH_SIZE=200
# SENDGRID_WORKER_CONCURRENCY=4
# SENDGRID_MAX_RPS=8

