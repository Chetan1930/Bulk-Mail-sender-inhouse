DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mailflow"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="http://localhost:8080"

# Required administrator account
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# SendGrid API key (server only)
SENDGRID_API_KEY=

# SendGrid throughput (BullMQ + personalization batches)
# emails/sec ≈ SENDGRID_BATCH_SIZE × SENDGRID_MAX_RPS (capped by concurrency)
SENDGRID_BATCH_SIZE=200
SENDGRID_WORKER_CONCURRENCY=4
SENDGRID_MAX_RPS=8

